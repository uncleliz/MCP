  "gitlab_search_code": {
    "description": "Tìm code (blob) trong một project hoặc toàn instance, lọc tuỳ chọn theo ref và tên file. Kết quả có link web tới đúng file/dòng. File khớp deny-glob bị loại.",
    "inputSchema": {
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cursor opaque lấy từ meta.next_cursor của lần gọi trước.",
          "title": "Cursor"
        },
        "filename_filter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ví dụ `*.py`.",
          "title": "Filename Filter"
        },
        "limit": {
          "default": 20,
          "description": "Số item tối đa trả về (1..100).",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "path_with_namespace hoặc id; null = toàn instance.",
          "title": "Project"
        },
        "query": {
          "maxLength": 512,
          "minLength": 2,
          "title": "Query",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Branch/tag; mặc định default branch.",
          "title": "Ref"
        }
      },
      "required": [
        "query"
      ],
      "title": "gitlab_search_codeArguments",
      "type": "object"
    }
  },
