# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/

# uv
# (uv.lock IS committed intentionally — reproducible installs)

# Env files (real secrets) — .env.example is the committed template
.env
*.env
!.env.example

# Ingest source credentials (real secrets) — never commit
# Token files and the credentials directory; *.example templates ARE committed
.token-key
*.token
*.token-key
credentials/*
secrets/*
!credentials/*.example
!credentials/.*.example
!secrets/*.example
!secrets/.*.example

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Docker / local infra state
infra/**/data/
# opc-init
.kiro/squad/notify.local.env
.kiro/squad/backup/
.kiro/worktrees/
.kiro/squad/worktree.env
.kiro/squad/coord/

# Squad install backups (R-027)
.claude/squad/backup/

# Squad Telegram bridge runtime state (session/offset/log — never commit; may carry session secrets)
.claude/squad/telegram.session
.claude/squad/telegram.offset
.claude/squad/telegram-bridge.log
.claude/squad/notify.local.env
