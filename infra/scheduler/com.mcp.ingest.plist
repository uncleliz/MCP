<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Hourly incremental run (every hour except 03:00, which belongs to the full reconcile in com.mcp.ingest.full.plist).
  THRESHOLD TBD (Open question 5, PO confirmation pending): cadence.
  Install: replace /path/to/MCP, copy to ~/Library/LaunchAgents/, `launchctl load ~/Library/LaunchAgents/com.mcp.ingest.plist`.
  Credentials are NOT here: they live in ~/.config/mcp-ingest/env (read by run-ingest.sh).
-->
<dict>
	<key>Label</key>
	<string>com.mcp.ingest</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/MCP/infra/scheduler/run-ingest.sh</string>
		<string>incremental</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/tmp/mcp-ingest.launchd.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/mcp-ingest.launchd.out.log</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>0</integer>
			<key>Minute</key>
			<integer>0</integer>
