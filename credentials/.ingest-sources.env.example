# =============================================================================
# Khai báo tài khoản ingest cho các nguồn (TEMPLATE — an toàn để commit)
# =============================================================================
# File này là MẪU. Để dùng thật:
#   1. cp credentials/ingest-sources.env.example credentials/ingest-sources.env
#   2. điền giá trị thật vào credentials/ingest-sources.env  (file đó bị .gitignore)
#   3. source credentials/ingest-sources.env   (hoặc trỏ *_FILE tới file token)
#
# QUY TẮC AN TOÀN:
#   - KHÔNG viết token trực tiếp vào file này. Dùng *_FILE trỏ tới file token read-only.
#   - Token phải là READ-ONLY, least-privilege. `doctor` sẽ từ chối tài khoản có quyền ghi.
#   - credentials/ và *.token / *.token-key đã bị .gitignore — không bao giờ commit secret.
#   - MCP_EGRESS_ALLOWLIST mặc định rỗng = chặn mọi egress. Phải liệt kê host nguồn mới pull được.
# =============================================================================

# --- Egress allow-list (BẮT BUỘC cho ingest thật) -----------------------------
# Chỉ các host liệt kê ở đây mới được phép gọi ra ngoài trên đường ingest-pull + tải model.
# Confluence trước; thêm host khác khi bật nguồn tương ứng.
MCP_EGRESS_ALLOWLIST='*.atlassian.net'
# Khi đo NFR-003 bằng model thật, thêm huggingface.co:
#   MCP_EGRESS_ALLOWLIST='*.atlassian.net,huggingface.co'

# Cho phép lần egress THẬT (mặc định off). Chỉ bật khi chạy pull/tải model thật.
MCP_INGEST_ALLOW_LIVE_EGRESS=false

# =============================================================================
# 4 NGUỒN INGEST ĐƯỢC (ingestable): kéo nội dung vào knowledge base
# =============================================================================

# --- 1) Confluence Cloud (ƯU TIÊN) -------------------------------------------
MCP_CONFLUENCE_BASE_URL=https://your-tenant.atlassian.net/wiki
MCP_CONFLUENCE_FLAVOR=cloud
MCP_CONFLUENCE_EMAIL=service-account@your-company.com
# Trỏ tới file token read-only (KHÔNG viết token ở đây):
MCP_CONFLUENCE_API_TOKEN_FILE=/absolute/path/to/confluence.token
# Space cần ingest (phẩy ngăn cách), ví dụ: ENG,PLATFORM
MCP_INGEST_CONFLUENCE_TEAM_SPACES=SPACE_KEYS

# --- 2) GitLab ----------------------------------------------------------------
# MCP_GITLAB_BASE_URL=https://gitlab.your-company.com
# MCP_GITLAB_PRIVATE_TOKEN_FILE=/absolute/path/to/gitlab.token   # read-only (read_api)

# --- 3) OpenSearch (ingest tắt mặc định) --------------------------------------
# MCP_OPENSEARCH_URL=https://opensearch.your-company.com
# MCP_OPENSEARCH_USERNAME=ro_user
# MCP_OPENSEARCH_PASSWORD_FILE=/absolute/path/to/opensearch.pass

# --- 4) Jira ------------------------------------------------------------------
# MCP_JIRA_BASE_URL=https://your-tenant.atlassian.net
# MCP_JIRA_FLAVOR=auto
# MCP_JIRA_EMAIL=service-account@your-company.com
# MCP_JIRA_API_TOKEN_FILE=/absolute/path/to/jira.token           # read-only

# =============================================================================
# 5 NGUỒN LIVE-ONLY: chỉ đọc trực tiếp, KHÔNG ingest
# (khai báo để doctor + đăng ký Claude Desktop; không có bước ingest)
# =============================================================================
# --- CloudWatch / SQS-SNS (AWS) ---
# AWS_REGION=ap-southeast-1
# (dùng chuỗi credential mặc định của AWS; nếu cần: *_SECRET_ACCESS_KEY_FILE)
# --- Kibana ---
# MCP_KIBANA_URL=... ; MCP_KIBANA_USERNAME=... ; MCP_KIBANA_PASSWORD_FILE=...
# --- Kafka ---
# MCP_KAFKA_BOOTSTRAP=... ; MCP_KAFKA_SASL_PASSWORD_FILE=...
# --- Redis ---
# MCP_REDIS_URL=... ; MCP_REDIS_PASSWORD_FILE=...
