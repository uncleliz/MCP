# MCP Data Platform — environment variables reference (T-004).
#
# This file is ONLY an example: copy it to `.env` (never commit `.env`) or, for Claude
# Desktop/Code, paste the equivalent `env` block into `claude_desktop_config.json` (see
# `uv run mcp-common config-emit --server <name>`, T-016). No secret value below is real.
#
# Every server reads: `MCP_*` (shared, this file's first section) + `MCP_<SOURCE>_*`
# (per-server, one section per source below). `doctor` (per package `cli.py`) checks
# these at startup and fails fast with the exact variable name if something required
# is missing (ADR-0005).
#
# `*_FILE` convention: any SecretStr-typed variable below also accepts a `<NAME>_FILE`
# variant pointing at a file whose (stripped) contents are the secret — useful for
# `pass`/keychain export. Never both at once.

# =============================================================================
# Shared — mcp_common.config.CommonSettings (env prefix MCP_)
# =============================================================================

# HTTP client timeout budget (ADR-0006 A2). Do not raise READ_TIMEOUT without also
# reconsidering MCP_TOOL_DEADLINE — the invariant is
# 2 * (CONNECT_TIMEOUT + READ_TIMEOUT) + backoff < MCP_TOOL_DEADLINE.
MCP_HTTP_CONNECT_TIMEOUT=3
MCP_HTTP_READ_TIMEOUT=7
MCP_HTTP_WRITE_TIMEOUT=5
MCP_HTTP_POOL_TIMEOUT=5
# Total attempts = 1 + MCP_HTTP_MAX_RETRIES. Chốt lại ADR-0006 A2: 1 retry (2 attempts).
MCP_HTTP_MAX_RETRIES=1
MCP_HTTP_BACKOFF_BASE=1

# Deadline (seconds) for one whole tool call, applied even to non-HTTP SDKs
# (Kafka/Redis/Postgres/boto3) via mcp_common.runtime. 25s per ADR-0006 A2.
MCP_TOOL_DEADLINE=25
# Per-tool override for legitimately slow tools (ADR-0006 A2). Example:
# MCP_TOOL_DEADLINE_CLOUDWATCH_RUN_LOGS_INSIGHTS=60
# MCP_TOOL_DEADLINE_OPENSEARCH_SEARCH_DSL=45

# Hard cap on response payload size (bytes). Effective cap = min(tool's max_bytes, this).
MCP_MAX_OUTPUT_BYTES=131072
# Hard cap on any tool's requested time range (days), to avoid unbounded log/metric scans.
MCP_MAX_TIME_RANGE_DAYS=31

# Structured JSON logging goes to stderr ONLY (stdout is the JSON-RPC channel, R2).
MCP_LOG_LEVEL=INFO
# Optional: also write logs to a file (never stdout).
# MCP_LOG_FILE=/var/log/mcp/mcp-confluence.log

# Redaction of secret-looking strings in logs and tool output (ADR-0015). Turning this
# off must be an explicit operator action, never a silent default.
MCP_REDACT_DISABLED=false

# v1 only supports stdio. Any other value makes build_server() fail-closed with
# source_misconfigured (ADR-0002, ADR-0013 x-transport).
MCP_TRANSPORT=stdio

# Escape hatch for the startup credential gate (ADR-0003 A1). Setting this to true
# skips the "is this credential actually read-only" check and logs one WARN per
# startup. Leave false/unset in normal operation.
MCP_ALLOW_UNVERIFIED_CREDENTIALS=false

# =============================================================================
# mcp-confluence (env prefix MCP_CONFLUENCE_) — Phase 1, FR-001
# =============================================================================
MCP_CONFLUENCE_BASE_URL=https://your-domain.atlassian.net/wiki
# Cloud flavor confirmed at Gate B (test-plan.md) — Cloud REST API under /wiki/rest/api.
MCP_CONFLUENCE_FLAVOR=cloud
MCP_CONFLUENCE_EMAIL=you@example.com
MCP_CONFLUENCE_API_TOKEN=changeme-confluence-api-token
# MCP_CONFLUENCE_API_TOKEN_FILE=/run/secrets/confluence_api_token

# =============================================================================
# mcp-gitlab (env prefix MCP_GITLAB_) — Phase 1, FR-002
# =============================================================================
MCP_GITLAB_BASE_URL=https://gitlab.example.com
MCP_GITLAB_PRIVATE_TOKEN=changeme-gitlab-pat-with-read_api-scope-only
# MCP_GITLAB_PRIVATE_TOKEN_FILE=/run/secrets/gitlab_pat
# Deny-glob for sensitive paths, applied at the connector layer so mcp-ingest reuses it
# (ADR-0015 A1). Comma-separated glob patterns.
MCP_GITLAB_PATH_DENY=*.env,*secret*,*credential*,*.pem,id_rsa*

# =============================================================================
# mcp-opensearch (env prefix MCP_OPENSEARCH_) — Phase 2, FR-004
# =============================================================================
MCP_OPENSEARCH_HOSTS=https://opensearch.example.internal:9200
MCP_OPENSEARCH_USERNAME=changeme
MCP_OPENSEARCH_PASSWORD=changeme-opensearch-password
# MCP_OPENSEARCH_PASSWORD_FILE=/run/secrets/opensearch_password
MCP_OPENSEARCH_VERIFY_CERTS=true
# `opensearch_search_dsl` is an escape hatch (arbitrary query DSL, guarded) and is NOT registered
# unless this is true. Slow-but-valid DSL queries need MCP_TOOL_DEADLINE_OPENSEARCH_SEARCH_DSL.
MCP_OPENSEARCH_ALLOW_DSL=false
# Startup check (ADR-0003 A1): refuse to serve if the credential maps to any of these
# security-plugin roles. The user also needs access to /_plugins/_security/authinfo.
MCP_OPENSEARCH_DENY_ROLES=all_access,security_manager,admin

# =============================================================================
# mcp-kibana (env prefix MCP_KIBANA_) — Phase 2, FR-005
# =============================================================================
MCP_KIBANA_BASE_URL=https://kibana.example.internal:5601
MCP_KIBANA_USERNAME=changeme
MCP_KIBANA_PASSWORD=changeme-kibana-password
# MCP_KIBANA_PASSWORD_FILE=/run/secrets/kibana_password
MCP_KIBANA_VERIFY_CERTS=true

# =============================================================================
# mcp-cloudwatch (env prefix MCP_CLOUDWATCH_) — Phase 2, FR-006
# =============================================================================
MCP_CLOUDWATCH_REGION=ap-southeast-1
MCP_CLOUDWATCH_AWS_ACCESS_KEY_ID=changeme
MCP_CLOUDWATCH_AWS_SECRET_ACCESS_KEY=changeme-aws-secret-key
# MCP_CLOUDWATCH_AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/cloudwatch_secret_key
# Optional: assume a read-only role instead of using long-lived keys directly.
# MCP_CLOUDWATCH_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/mcp-readonly
# Leave the two key variables unset to use boto3's default credential chain (profile/SSO/role).
# Startup check: write actions that iam:SimulatePrincipalPolicy must NOT report as `allowed`.
# MCP_CLOUDWATCH_SIMULATE_ACTIONS=logs:PutLogEvents,logs:DeleteLogGroup,cloudwatch:PutMetricData
# Seconds between GetQueryResults polls of a Logs Insights query.
# MCP_CLOUDWATCH_INSIGHTS_POLL_INTERVAL=1
# Local emulator / VPC endpoint only.
# MCP_CLOUDWATCH_ENDPOINT_URL=http://localhost:4566

# =============================================================================
# mcp-kafka (env prefix MCP_KAFKA_) — Phase 2, FR-007
# =============================================================================
MCP_KAFKA_BOOTSTRAP_SERVERS=kafka.example.internal:9092
MCP_KAFKA_SECURITY_PROTOCOL=SASL_SSL
MCP_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
MCP_KAFKA_SASL_USERNAME=changeme
MCP_KAFKA_SASL_PASSWORD=changeme-kafka-password
# MCP_KAFKA_SASL_PASSWORD_FILE=/run/secrets/kafka_password
# MCP_KAFKA_SSL_CA_LOCATION=/etc/ssl/certs/internal-ca.pem
# MCP_KAFKA_CLIENT_ID=mcp-kafka-readonly
# socket.timeout.ms / metadata.request.timeout.ms are fixed at 8000 in code (ADR-0006 A2),
# not overridable via env, to keep the 21s < 25s budget invariant intact.

# =============================================================================
# mcp-redis (env prefix MCP_REDIS_) — Phase 2, FR-008
# =============================================================================
MCP_REDIS_URL=redis://mcp_ro@redis.example.internal:6379/0
MCP_REDIS_PASSWORD=changeme-redis-acl-password
# MCP_REDIS_PASSWORD_FILE=/run/secrets/redis_password
# Deny-glob for sensitive keys (ADR-0015).
MCP_REDIS_KEY_DENY=*.env,*secret*,*credential*,*.pem,id_rsa*
# The ACL user needs +acl|getuser (startup read-only check, ADR-0008 A1). The `db` tool argument
# other than 0 additionally needs +select in the ACL (connecting to db N sends SELECT).

# =============================================================================
# mcp-sqs-sns (env prefix MCP_SQS_SNS_) — Phase 3, FR-010
# =============================================================================
# Metadata only: the server never reads message bodies (sqs:ReceiveMessage changes the
# visibility timeout, so it is excluded by design). Use a least-privilege IAM policy:
# sqs:ListQueues/GetQueueUrl/GetQueueAttributes/ListQueueTags/ListDeadLetterSourceQueues,
# sns:ListTopics/GetTopicAttributes/ListSubscriptionsByTopic, sts:GetCallerIdentity and
# (optional, enables the startup write-permission assert) iam:SimulatePrincipalPolicy.
MCP_SQS_SNS_REGION=ap-southeast-1
MCP_SQS_SNS_AWS_ACCESS_KEY_ID=changeme
MCP_SQS_SNS_AWS_SECRET_ACCESS_KEY=changeme-aws-secret-key
# MCP_SQS_SNS_AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/sqs_sns_secret_key
# Leave unset for real AWS (default credential chain when the two keys above are unset).
# For LocalStack (infra/docker-compose.yml) or a VPC endpoint only:
# MCP_SQS_SNS_ENDPOINT_URL=http://localhost:4566

# =============================================================================
# mcp-pgvector (env prefix MCP_PGVECTOR_) — Phase 3, FR-011
# =============================================================================
# MUST be the read-only role (mcp_query_ro), never mcp_ingest_rw or a superuser — the startup
# check refuses to serve otherwise, and MCP_ALLOW_UNVERIFIED_CREDENTIALS does NOT bypass that.
# The server also refuses to serve when the embedding model below differs from the model stored
# in kb.chunks (run `mcp-ingest reembed` first). Roles have no password after
# `mcp-ingest db upgrade`: set one out of band (infra/dev-setup.md).
MCP_PGVECTOR_DSN=postgresql://mcp_query_ro:changeme@localhost:5432/mcp_kb
# MCP_PGVECTOR_DSN_FILE=/run/secrets/pgvector_dsn
# Optional per-server override of MCP_INGEST_EMBEDDING_MODEL (same model_id string as stored in
# kb.chunks.embedding_model, e.g. BAAI/bge-m3). Normally leave unset: server and pipeline share
# the MCP_INGEST_EMBEDDING_* settings below so they embed in the same vector space.
# MCP_PGVECTOR_EMBEDDING_MODEL=BAAI/bge-m3

# =============================================================================
# Embedding provider shared by mcp-ingest and mcp-pgvector (MCP_INGEST_EMBEDDING_*) — ADR-0010
# =============================================================================
# PROVISIONAL default: BAAI/bge-m3 (spike S2 could not measure; docs/spikes/S2-embedding-bakeoff.md).
# Both candidates are 1024-d, so switching model needs `mcp-ingest reembed`, not a migration.
MCP_INGEST_EMBEDDING_PROVIDER=local
MCP_INGEST_EMBEDDING_MODEL=BAAI/bge-m3
MCP_INGEST_EMBEDDING_DIMENSIONS=1024
# MCP_INGEST_EMBEDDING_NORMALIZE=true
# MCP_INGEST_EMBEDDING_MAX_INPUT_TOKENS=       # empty = model default (bge-m3 8192, e5 512)
# MCP_INGEST_EMBEDDING_BATCH_SIZE=16
# MCP_INGEST_EMBEDDING_DEVICE=cpu
# provider=http (OpenAI-compatible POST <url>/embeddings; OpenAI, Voyage, TEI, vLLM):
# MCP_INGEST_EMBEDDING_URL=https://embeddings.example.internal/v1
# MCP_INGEST_EMBEDDING_API_KEY=changeme-embedding-api-key
# MCP_INGEST_EMBEDDING_API_KEY_FILE=/run/secrets/embedding_api_key

# =============================================================================
# mcp-ingest CLI (env prefix MCP_INGEST_) — Phase 3, FR-012 (not a server; no stdio/stdout guard applies)
# =============================================================================
# DDL-capable DSN used ONLY by `mcp-ingest db upgrade` (CREATE EXTENSION / CREATE ROLE need more
# than DML rights). Falls back to MCP_INGEST_PGVECTOR_DSN when that role may do DDL.
MCP_INGEST_ADMIN_DSN=postgresql://mcp_admin:changeme@localhost:5432/mcp_kb
# Write-capable role — only mcp-ingest ever uses this DSN. Never reuse it for
# MCP_PGVECTOR_DSN above.
MCP_INGEST_PGVECTOR_DSN=postgresql://mcp_ingest_rw:changeme@localhost:5432/mcp_kb
MCP_INGEST_MAX_DOC_RETRIES=2
# Default EMPTY = OpenSearch ingest connector disabled (ADR-0012 A5). Comma-separated
# allowlist of index name patterns to opt specific runbook/postmortem indices in.
MCP_INGEST_OPENSEARCH_INDICES=
# --- Team-only corpus policy (ADR-0016 Part 2, spike S5). Read by the connectors (T-070/T-071,
# next batch); documents that cannot be proved team-visible are labelled `restricted` and rejected.
# Confluence: space keys the operator declares team-wide (empty = nothing is team content).
# MCP_INGEST_CONFLUENCE_TEAM_SPACES=PAY,OPS
# GitLab: private-project path prefixes declared team-wide (public/internal projects are team).
# MCP_INGEST_GITLAB_TEAM_PROJECTS=payments,platform/tools
# Set false when the GitLab instance has users outside the team ("internal" is then restricted).
# MCP_INGEST_GITLAB_INTERNAL_IS_TEAM=true
